# Server Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Security & Sessions
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars
COOKIE_SECRET=dev-cookie-secret-change-in-production-min-32-chars
TOKEN_SECRET=dev-token-secret-change-in-production-min-32-chars

# Database (MongoDB Single-Node Replica Set for Transactions)
MONGODB_URI=mongodb://localhost:27017/slotify?replicaSet=rs0&directConnection=true

# Message Queue (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Email (Mailpit Local Sandbox)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@slotify.local

# Cloudflare Edge Simulation / Rate Limiting
EDGE_SYNC_INTERVAL_SEC=5
DEFAULT_TENANT_LEASE_SIZE=20
